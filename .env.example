# ─────────────────────────────────────────────────────────────
#  Galaxy Cards — variáveis de ambiente
#  Copie este arquivo para .env e preencha.
# ─────────────────────────────────────────────────────────────

# 1) Banco (Neon Postgres — grátis, sem cartão). Ver SETUP.md passo 1.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2) Código de acesso. Gere as duas linhas abaixo com:
#       npm run passcode -- "seu-codigo-secreto"
PASSCODE_HASH=""
SESSION_SECRET=""

# 3) Áudio (Google Cloud Text-to-Speech). Ver SETUP.md passo 3.
#    Deixe vazio para usar a voz do próprio navegador.
GOOGLE_TTS_API_KEY=""
TTS_VOICE="en-US-Neural2-F"
TTS_RATE="0.95"

# Porta da API em desenvolvimento
PORT=3001
